{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:contracts:0.1",
  "title": "Ariadne v0.1 illustrative design contracts",
  "description": "Design draft. Shape validation is not authorization, freshness checking, or a desktop safety guarantee.",
  "oneOf": [
    {
      "$ref": "#/$defs/TaskSpec"
    },
    {
      "$ref": "#/$defs/BrowserActionTask"
    },
    {
      "$ref": "#/$defs/ReadSessionSpec"
    },
    {
      "$ref": "#/$defs/ReadTaskSpec"
    },
    {
      "$ref": "#/$defs/ReadTaskResult"
    },
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/PreparedOperation"
    },
    {
      "$ref": "#/$defs/HostReceipt"
    },
    {
      "$ref": "#/$defs/TaskResult"
    },
    {
      "$ref": "#/$defs/Decision"
    }
  ],
  "$defs": {
    "ReadLimits": {
      "type": "object",
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 33554432
        },
        "maxCaptureMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 20000
        },
        "maxCaptures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "required": [
        "maxNodes",
        "maxDepth",
        "maxBytes",
        "maxCaptureMs",
        "maxCaptures",
        "deadlineMs"
      ],
      "additionalProperties": false
    },
    "PageScope": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "origins"
      ],
      "additionalProperties": false
    },
    "DocumentStamp": {
      "type": "object",
      "properties": {
        "sessionEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "sessionEpoch",
        "ref",
        "generation"
      ],
      "additionalProperties": false
    },
    "ReadSessionSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "read_session"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "readSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "scopeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "limits": {
          "$ref": "#/$defs/ReadLimits"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "readSessionId",
        "scopeRef",
        "limits"
      ],
      "additionalProperties": false
    },
    "BrowserActionTask": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "browser_action_task"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "recipeId": {
          "const": "browser-actions.v1"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scopeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          },
          "maxProperties": 32
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "kind": {
                    "const": "invoke"
                  }
                },
                "required": [
                  "id",
                  "purpose",
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "kind": {
                    "const": "set_value"
                  },
                  "inputRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  }
                },
                "required": [
                  "id",
                  "purpose",
                  "kind",
                  "inputRef"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "attribute": {
                "enum": [
                  "name",
                  "value"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "match": {
                "enum": [
                  "equals",
                  "contains"
                ]
              }
            },
            "required": [
              "id",
              "attribute",
              "text",
              "match"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "limits": {
          "$ref": "#/$defs/ReadLimits"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "recipeId",
        "taskId",
        "revision",
        "scopeRef",
        "goal",
        "inputs",
        "steps",
        "requiredChecks",
        "limits"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "nodeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "field": {
          "enum": [
            "name",
            "role",
            "parentRef",
            "value",
            "enabled",
            "capabilities"
          ]
        }
      },
      "required": [
        "observationId",
        "nodeRef",
        "field"
      ],
      "additionalProperties": false
    },
    "CheckSpec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "const": "value_equals_input"
        },
        "slotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "inputRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "comparison": {
          "const": "exact"
        }
      },
      "required": [
        "id",
        "kind",
        "slotId",
        "inputRef",
        "comparison"
      ],
      "additionalProperties": false
    },
    "TaskSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scopeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "recipeId": {
          "const": "fill-fields.v1"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          },
          "minProperties": 1,
          "maxProperties": 16
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "inputRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "regionHint": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "required": [
              "id",
              "meaning",
              "inputRef",
              "regionHint"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckSpec"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "budgets": {
          "type": "object",
          "properties": {
            "maxOperations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxSemanticRequests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxObservationExpansions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "deadlineMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 600000
            }
          },
          "required": [
            "maxOperations",
            "maxSemanticRequests",
            "maxObservationExpansions",
            "deadlineMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "taskId",
        "revision",
        "goal",
        "scopeRef",
        "recipeId",
        "inputs",
        "slots",
        "requiredChecks",
        "budgets"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "parentRef": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "application",
            "window",
            "dialog",
            "group",
            "text_field",
            "text_area",
            "button",
            "text",
            "unknown"
          ]
        },
        "nativeRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "name": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "available"
                },
                "value": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "status",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "redacted",
                    "error"
                  ]
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "available"
                },
                "value": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "status",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "redacted",
                    "error"
                  ]
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          ]
        },
        "enabled": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "available"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "status",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unsupported",
                    "redacted",
                    "error"
                  ]
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "invoke",
              "set_value"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "ref",
        "parentRef",
        "role",
        "nativeRole",
        "name",
        "value",
        "enabled",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "observation"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "sessionEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "scopeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "capture": {
          "type": "object",
          "properties": {
            "startedMonoMs": {
              "type": "integer",
              "minimum": 0
            },
            "endedMonoMs": {
              "type": "integer",
              "minimum": 0
            },
            "eventSeqBefore": {
              "type": "integer",
              "minimum": 0
            },
            "eventSeqAfter": {
              "type": "integer",
              "minimum": 0
            },
            "consistency": {
              "enum": [
                "best_effort",
                "atomic"
              ]
            }
          },
          "required": [
            "startedMonoMs",
            "endedMonoMs",
            "eventSeqBefore",
            "eventSeqAfter",
            "consistency"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "rootRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "status": {
              "enum": [
                "provider_exhausted",
                "partial"
              ]
            },
            "omittedReasons": {
              "type": "array",
              "items": {
                "enum": [
                  "budget",
                  "virtualized",
                  "unsupported",
                  "error",
                  "redacted",
                  "frame"
                ]
              },
              "uniqueItems": true
            },
            "nodeCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "rootRef",
            "status",
            "omittedReasons",
            "nodeCount"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "minItems": 1,
          "maxItems": 65536
        },
        "document": {
          "$ref": "#/$defs/DocumentStamp"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "observationId",
        "sessionEpoch",
        "scopeRef",
        "capture",
        "coverage",
        "nodes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "document"
              ]
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "maxItems": 2048
              }
            }
          }
        }
      ]
    },
    "ReadTaskSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "read_task"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "recipeId": {
          "const": "project-ax-text.v1"
        },
        "completeness": {
          "const": "observed_region"
        },
        "readSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "scopeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "document": {
          "$ref": "#/$defs/DocumentStamp"
        },
        "nativeRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AX[A-Za-z0-9]+$",
            "maxLength": 128
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "attributes": {
          "type": "array",
          "items": {
            "enum": [
              "name",
              "value"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxRecords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 8192,
              "maximum": 134217728
            }
          },
          "required": [
            "maxRecords",
            "maxOutputBytes"
          ],
          "additionalProperties": false
        },
        "rootRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "taskId",
        "revision",
        "recipeId",
        "completeness",
        "readSessionId",
        "scopeRef",
        "document",
        "nativeRoles",
        "attributes",
        "limits"
      ],
      "additionalProperties": false
    },
    "LiteralSpan": {
      "type": "object",
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "nodeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "attribute": {
          "enum": [
            "name",
            "value"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "unicode_scalar"
        }
      },
      "required": [
        "observationId",
        "nodeRef",
        "attribute",
        "start",
        "end",
        "unit"
      ],
      "additionalProperties": false
    },
    "ProjectedAttribute": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "attribute": {
              "enum": [
                "name",
                "value"
              ]
            },
            "status": {
              "const": "available"
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "evidence": {
              "$ref": "#/$defs/LiteralSpan"
            }
          },
          "required": [
            "attribute",
            "status",
            "text",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
